{
  "name": "varn-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:private": "vite --mode private",
    "check:records": "node scripts/check-records.mjs",
    "export:facts": "node scripts/export-facts.mjs",
    "prebuild": "node scripts/check-records.mjs",
    "build": "vite build",
    "build:private": "vite build --mode private --outDir dist-private --emptyOutDir",
    "postbuild": "node scripts/check-no-ask.mjs",
    "check:no-ask": "node scripts/check-no-ask.mjs",
    "preview": "vite preview",
    "test": "node --test src/sky/sky.test.js src/globe/hillshade.test.js src/globe/commands.test.js src/globe/buildingsData.test.js src/globe/inspect.test.js src/records/rules.test.js src/records/model.test.js src/records/render.test.js src/ask/summary.test.js src/ask/client.test.js src/ask/panel.test.js src/ask/build.test.js worker/test/*.test.js"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "cesium": "^1.146.0",
    "lucide-react": "^0.468.0",
    "pbf": "^4.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0"
  }
}
